{
    "name": "tomsgu/xutim",
    "description": "Modular CMS system with Symfony, Doctrine ORM, Turbo/Stimulus, and Editor.js. Includes main application and internal bundles/libraries in a monorepo structure.",
    "license": "MIT",
    "type": "project",
    "authors": [
        {
            "name": "Tomas Jakl",
            "email": "tomasjakll@gmail.com"
        }
    ],
    "require": {
        "babdev/pagerfanta-bundle": "^4.5",
        "doctrine/doctrine-bundle": "^3.3",
        "doctrine/doctrine-migrations-bundle": "^4.0",
        "doctrine/orm": "^3.7",
        "dragonmantank/cron-expression": "^3.4",
        "dunglas/doctrine-json-odm": "^1.4",
        "ext-ctype": "*",
        "ext-gd": "*",
        "ext-iconv": "*",
        "ext-mbstring": "*",
        "ext-pdo": "*",
        "ext-pgsql": "*",
        "gedmo/doctrine-extensions": "^3.22",
        "jcupitt/vips": "^2.6",
        "jdenticon/jdenticon": "^2.0",
        "pagerfanta/doctrine-orm-adapter": "^4.7",
        "pagerfanta/twig": "^4.7",
        "php": ">=8.4",
        "spatie/image": "^3.8",
        "spatie/image-optimizer": "^1.8",
        "stof/doctrine-extensions-bundle": "^1.13",
        "symfony-cmf/routing-bundle": "^3.1",
        "symfony/asset": "8.1.*",
        "symfony/asset-mapper": "8.1.*",
        "symfony/console": "8.1.*",
        "symfony/css-selector": "8.1.*",
        "symfony/doctrine-messenger": "8.1.*",
        "symfony/dom-crawler": "8.1.*",
        "symfony/dotenv": "8.1.*",
        "symfony/flex": "^2",
        "symfony/form": "8.1.*",
        "symfony/framework-bundle": "8.1.*",
        "symfony/http-client": "8.1.*",
        "symfony/intl": "8.1.*",
        "symfony/mailer": "8.1.*",
        "symfony/mercure-bundle": "^0.7",
        "symfony/messenger": "8.1.*",
        "symfony/mime": "8.1.*",
        "symfony/monolog-bundle": "^4.0",
        "symfony/runtime": "8.1.*",
        "symfony/scheduler": "8.1.*",
        "symfony/security-bundle": "8.1.*",
        "symfony/serializer": "8.1.*",
        "symfony/stimulus-bundle": "^3.0",
        "symfony/string": "8.1.*",
        "symfony/translation": "8.1.*",
        "symfony/twig-bundle": "8.1.*",
        "symfony/uid": "8.1.*",
        "symfony/ux-dropzone": "^3.0",
        "symfony/ux-icons": "^3.0",
        "symfony/ux-live-component": "^3.0",
        "symfony/ux-turbo": "^3.0",
        "symfony/ux-twig-component": "^3.0",
        "symfony/validator": "8.1.*",
        "symfony/yaml": "8.1.*",
        "symfonycasts/dynamic-forms": "^0.2",
        "symfonycasts/reset-password-bundle": "^1.23",
        "symfonycasts/tailwind-bundle": "^1.0",
        "twig/extra-bundle": "^3.20",
        "twig/intl-extra": "^3.20",
        "twig/string-extra": "^3.20",
        "twig/twig": "^3.20",
        "ua-parser/uap-php": "^3.10",
        "webmozart/assert": "^2.0",
        "symfony/clock": "8.1.*",
        "symfony/error-handler": "8.1.*",
        "symfony/event-dispatcher": "8.1.*",
        "symfony/filesystem": "8.1.*",
        "symfony/finder": "8.1.*",
        "symfony/http-foundation": "8.1.*",
        "symfony/options-resolver": "8.1.*",
        "symfony/password-hasher": "8.1.*",
        "symfony/routing": "8.1.*",
        "symfony/security-core": "8.1.*",
        "symfony/security-csrf": "8.1.*",
        "symfony/security-http": "8.1.*",
        "symfony/twig-bridge": "8.1.*",
        "symfony/type-info": "8.1.*",
        "symfony/var-dumper": "8.1.*",
        "symfony/var-exporter": "8.1.*"
    },
    "require-dev": {
        "dama/doctrine-test-bundle": "^8.2",
        "doctrine/doctrine-fixtures-bundle": "^4.0",
        "friendsoftwig/twigcs": "^6.5",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan": "^2.3",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "phpstan/phpstan-doctrine": "^2.1.2",
        "phpstan/phpstan-phpunit": "^2.1",
        "phpstan/phpstan-strict-rules": "^2.1",
        "phpstan/phpstan-symfony": "^2.1",
        "phpstan/phpstan-webmozart-assert": "^2.0",
        "phpunit/phpunit": "^13.0",
        "symfony/browser-kit": "8.1.*",
        "symfony/debug-bundle": "8.1.*",
        "symfony/maker-bundle": "^1.62",
        "symfony/phpunit-bridge": "8.1.*",
        "symfony/stopwatch": "8.1.*",
        "symfony/ux-chartjs": "^3.0",
        "symfony/web-profiler-bundle": "8.1.*",
        "symplify/easy-coding-standard": "^13.0",
        "symplify/monorepo-builder": "^12.0",
        "vincentlanglet/twig-cs-fixer": "^4.0",
        "zenstruck/foundry": "^2.0"
    },
    "replace": {
        "xutimcms/analytics-bundle": "self.version",
        "xutimcms/core-bundle": "self.version",
        "xutimcms/domain": "self.version",
        "xutimcms/event-bundle": "self.version",
        "xutimcms/media-bundle": "self.version",
        "xutimcms/notification-bundle": "self.version",
        "xutimcms/redirect-bundle": "self.version",
        "xutimcms/redirect-component": "self.version",
        "xutimcms/security-bundle": "self.version",
        "xutimcms/security-component": "self.version",
        "xutimcms/snippet-bundle": "self.version"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Xutim\\": "src/Xutim/",
            "Xutim\\AnalyticsBundle\\": "src/Xutim/Bundle/AnalyticsBundle/src/",
            "Xutim\\CoreBundle\\": "src/Xutim/Bundle/CoreBundle/src/",
            "Xutim\\Domain\\": "src/Xutim/Domain/src/",
            "Xutim\\EventBundle\\": "src/Xutim/Bundle/EventBundle/src/",
            "Xutim\\MediaBundle\\": "src/Xutim/Bundle/MediaBundle/src/",
            "Xutim\\NotificationBundle\\": "src/Xutim/Bundle/NotificationBundle/src/",
            "Xutim\\RedirectBundle\\": "src/Xutim/Bundle/RedirectBundle/src/",
            "Xutim\\RedirectComponent\\": "src/Xutim/Component/RedirectComponent/src/",
            "Xutim\\SecurityBundle\\": "src/Xutim/Bundle/SecurityBundle/src/",
            "Xutim\\SecurityComponent\\": "src/Xutim/Component/SecurityComponent/src/",
            "Xutim\\SnippetBundle\\": "src/Xutim/Bundle/SnippetBundle/src/"
        },
        "exclude-from-classmap": [
            "src/Xutim/Bundle/AnalyticsBundle/Tests/",
            "src/Xutim/Bundle/CoreBundle/Tests/",
            "src/Xutim/Bundle/EventBundle/Tests/",
            "src/Xutim/Bundle/MediaBundle/Tests/",
            "src/Xutim/Bundle/NotificationBundle/Tests/",
            "src/Xutim/Bundle/RedirectBundle/Tests/",
            "src/Xutim/Bundle/SecurityBundle/Tests/",
            "src/Xutim/Bundle/SnippetBundle/Tests/",
            "src/Xutim/Component/RedirectComponent/Tests/",
            "src/Xutim/Component/SecurityComponent/Tests/"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Xutim\\AnalyticsBundle\\Tests\\": "src/Xutim/Bundle/AnalyticsBundle/tests/",
            "Xutim\\CoreBundle\\Tests\\": "src/Xutim/Bundle/CoreBundle/tests/",
            "Xutim\\EventBundle\\Tests\\": "src/Xutim/Bundle/EventBundle/tests/",
            "Xutim\\MediaBundle\\Tests\\": "src/Xutim/Bundle/MediaBundle/tests/",
            "Xutim\\NotificationBundle\\Tests\\": "src/Xutim/Bundle/NotificationBundle/tests/",
            "Xutim\\RedirectBundle\\Tests\\": "src/Xutim/Bundle/RedirectBundle/tests/",
            "Xutim\\SecurityBundle\\Tests\\": "src/Xutim/Bundle/SecurityBundle/tests/",
            "Xutim\\SnippetBundle\\Tests\\": "src/Xutim/Bundle/SnippetBundle/tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "symfony/flex": false,
            "symfony/runtime": true,
            "phpstan/extension-installer": true
        }
    },
    "extra": {
        "symfony": {
            "allow-contrib": false,
            "require": "8.1.*"
        }
    }
}
