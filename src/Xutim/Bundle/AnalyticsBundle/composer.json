{
    "name": "xutimcms/analytics-bundle",
    "description": "Symfony bundle for privacy-first, anonymized analytics tracking.",
    "keywords": [
        "cms",
        "xutim",
        "symfony",
        "analytics",
        "bundle",
        "privacy",
        "symfony-ux"
    ],
    "homepage": "https://xutim.com",
    "license": "MIT",
    "authors": [
        {
            "name": "Tomas Jakl",
            "email": "tomasjakll@gmail.com"
        }
    ],
    "type": "symfony-bundle",
    "require": {
        "php": ">=8.4",
        "babdev/pagerfanta-bundle": "^4.5",
        "doctrine/doctrine-bundle": "^3.3",
        "doctrine/orm": "^3.7",
        "pagerfanta/doctrine-orm-adapter": "^4.7",
        "pagerfanta/twig": "^4.7",
        "symfony/console": "8.1.*",
        "symfony/form": "8.1.*",
        "symfony/framework-bundle": "8.1.*",
        "symfony/mailer": "8.1.*",
        "symfony/messenger": "8.1.*",
        "symfony/security-bundle": "8.1.*",
        "symfony/uid": "8.1.*",
        "symfony/ux-icons": "^3.0",
        "symfony/ux-twig-component": "^3.0",
        "symfony/validator": "8.1.*",
        "twig/extra-bundle": "^3.20",
        "twig/intl-extra": "^3.20",
        "twig/string-extra": "^3.20",
        "twig/twig": "^3.20",
        "ua-parser/uap-php": "^3.10",
        "xutimcms/core-bundle": "dev-main",
        "xutimcms/domain": "dev-main",
        "webmozart/assert": "^2.0",
        "symfony/doctrine-messenger": "8.1.*",
        "symfony/scheduler": "8.1.*"
    },
    "require-dev": {
        "dama/doctrine-test-bundle": "^8.2",
        "doctrine/doctrine-fixtures-bundle": "^4.0",
        "friendsoftwig/twigcs": "^6.5",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan": "^2.3",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "phpstan/phpstan-doctrine": "^2.1.2",
        "phpstan/phpstan-phpunit": "^2.1",
        "phpstan/phpstan-strict-rules": "^2.1",
        "phpstan/phpstan-symfony": "^2.1",
        "phpstan/phpstan-webmozart-assert": "^2.0",
        "phpunit/phpunit": "^13.0",
        "symfony/browser-kit": "8.1.*",
        "symfony/debug-bundle": "8.1.*",
        "symfony/maker-bundle": "^1.62",
        "symfony/phpunit-bridge": "8.1.*",
        "symfony/stopwatch": "8.1.*",
        "symfony/ux-chartjs": "^3.0",
        "symfony/web-profiler-bundle": "8.1.*",
        "symplify/easy-coding-standard": "^13.0",
        "vincentlanglet/twig-cs-fixer": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "Xutim\\AnalyticsBundle\\": "src/"
        },
        "exclude-from-classmap": [
            "/Tests/"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Xutim\\AnalyticsBundle\\Tests\\": "tests/"
        }
    },
    "suggest": {
        "symfony/ux-chartjs": "For visual charts in the analytics dashboard"
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
